  "text_layers": {
    "places_province": {
      "shapefilematch": ".*_adminareas_a_.*shp",
      "select": "fclass,name",
      "simplify": 0,
      "where": "fclass IN ('4') AND name IS NOT NULL AND name != ''",
      "gdal_args": [],
      "fallbacks": [
        {
          "shapefilematch": ".*_places_f.*shp",
          "where": "fclass IN ('state') AND name IS NOT NULL AND name != ''"
        }
      ]
    },
    "places_city": {
      "shapefilematch": ".*_adminareas_a_.*shp",
      "select": "fclass,name",
      "simplify": 0,
      "where": "fclass IN ('5') AND name IS NOT NULL AND name != ''",
      "gdal_args": [],
      "fallbacks": [
        {
          "shapefilematch": ".*_places_f.*shp",
          "where": "fclass IN ('city', 'national_capital') AND name IS NOT NULL AND name != ''"
        }
      ]
    },
    "places_county": {
      "shapefilematch": ".*_adminareas_a_.*shp",
      "select": "fclass,name",
      "simplify": 0,
