      "select": "fclass,name",
      "simplify": 0,
      "where": "fclass NOT IN ('4', '5', '6') AND name IS NOT NULL AND name != ''",
      "gdal_args": []
    },
    "roads": {
      "shapefilematch": ".*_roads_f.*shp",
      "select": "fclass,name,ref",
