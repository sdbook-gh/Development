# Local SDK path — copy to local.properties and edit.
# Android Studio usually creates this automatically when you open the project.

## Windows example
# sdk.dir=C\:\\Users\\YOU\\AppData\\Local\\Android\\Sdk

## WSL accessing Windows SDK example
# sdk.dir=/mnt/c/Users/YOU/AppData/Local/Android/Sdk

## Linux example
# sdk.dir=/home/YOU/Android/Sdk
