<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.mobiledatanotifier"
    android:compileSdkVersion="35"
    android:compileSdkVersionCodename="15">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <!-- 读取移动数据开关状态 -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- 监听网络连接变化 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 悬浮窗（屏幕顶部提示） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 开机自启 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 前台服务（保活） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 前台服务类型：specialUse（Android 14+） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 通知（Android 13+） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 请求加入电池优化白名单（保活） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 精确闹钟（定时提醒） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- 闹钟唤醒 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/Theme.MobileDataNotifier"
        android:allowBackup="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 保活前台服务 + 悬浮窗 -->
        <service
            android:name=".OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="continuous_mobile_data_usage_overlay_monitoring" />
        </service>

        <!-- 兜底保活：JobScheduler 周期心跳，服务被杀后自动拉起 -->
        <service
            android:name=".KeepAliveJob"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- 开机自启 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- 定时提醒接收器 -->
        <receiver
            android:name=".ScheduleReceiver"
            android:exported="false"
            android:enabled="true" />

    </application>

</manifest>
