workspace(name = "bazel_android_app")

load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive", "http_jar")

# ── Override R8 jar to use Aliyun mirror (maven.google.com is unreachable) ──
http_jar(
    name = "android_gmaven_r8",
    sha256 = "59753e70a74f918389cc87f1b7d66b5c0862932559167425708ded159e3de439",
    url = "https://maven.aliyun.com/repository/google/com/android/tools/r8/8.3.37/r8-8.3.37.jar",
)

# ── Android SDK ──────────────────────────────────────────────
android_sdk_repository(
    name = "androidsdk",
    path = "/mnt/d/devd/android/sdk-linux",
    api_level = 35,
    build_tools_version = "34.0.0",
)

# ── Android NDK ──────────────────────────────────────────────
android_ndk_repository(
    name = "androidndk",
    path = "/mnt/d/devd/android/sdk-linux/ndk/30.0.15729638",
    api_level = 33,
)

# ── rules_kotlin ─────────────────────────────────────────────
RULES_KOTLIN_VERSION = "1.9.0"

http_archive(
    name = "io_bazel_rules_kotlin",
    sha256 = "5766f1e599acf551aa56f49dab9ab9108269b03c557496c54acaf41f98e2b8d6",
    url = "https://github.com/bazelbuild/rules_kotlin/releases/download/v%s/rules_kotlin-v%s.tar.gz" % (RULES_KOTLIN_VERSION, RULES_KOTLIN_VERSION),
)

# Set up all rules_kotlin dependencies:
#   - Kotlin compiler (com_github_jetbrains_kotlin)
#   - KSP plugin
#   - bazel_skylib, rules_java, rules_python, rules_android, etc.
load("@io_bazel_rules_kotlin//kotlin:repositories.bzl", "kotlin_repositories")
kotlin_repositories()

# Register Kotlin toolchains
load("@io_bazel_rules_kotlin//kotlin:core.bzl", "kt_register_toolchains")
kt_register_toolchains()

# Register custom Android SDK toolchain (with patched dexer wrapper)
register_toolchains("//:custom_sdk_toolchain")
